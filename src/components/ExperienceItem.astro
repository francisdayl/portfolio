---
const { company, role, date, activities, isCurrent = false, textContext } = Astro.props;
---

<li class="mb-10 ms-6">
  <span
    class="absolute -start-3 flex size-6 items-center justify-center rounded-full bg-blue-300 dark:bg-blue-800 dark:ring-gray-900"
  ></span>
  <h3 class="mb-1 flex items-center text-lg font-semibold">
    <span>{role} - {company}</span>
    {
      isCurrent && (
        <span class="me-2 ms-3 rounded bg-blue-100 px-2.5 py-0.5 text-sm font-medium text-blue-800 dark:bg-blue-900 dark:text-blue-300">
          {textContext.Current}
        </span>
      )
    }
  </h3>
  <time class="mb-2 block text-sm font-normal leading-none text-gray-400 dark:text-gray-500"
    >{date}
  </time>
  <ul class="mb-4 flex flex-col gap-2 text-base font-normal text-gray-500 dark:text-gray-400">
    {
      activities.map((activity) => (
        <li class="ml-1 list-disc text-pretty">
          {activity.description}{' '}
          {activity.technologies && <strong>({activity.technologies.join(', ')})</strong>}
        </li>
      ))
    }
  </ul>
</li>
