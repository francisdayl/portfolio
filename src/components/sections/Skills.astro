---
import { IconSkill } from '../icons/index';

interface Skill {
  title: string;
  description: string;
  component: any;
}

interface SkillSet {
  name: string;
  skill: Skill[];
}

const textContext = Astro.props.textContext;
const skillSet: SkillSet[] = Astro.props.skillSet;
---

<h2 class="text-3xl font-semibold">{textContext.Title}</h2>

<table
  class="mx-auto mt-10 w-full text-left text-sm text-gray-500 dark:text-gray-400 rtl:text-right"
>
  <thead class="bg-gray-50 text-xs uppercase text-gray-700 dark:bg-gray-700 dark:text-gray-400">
    <tr>
      <th scope="col" class="px-6 py-3">
        {textContext.Category}
      </th>
      <th scope="col" class="px-6 py-3 text-center">
        {textContext.Tools}
      </th>
    </tr>
  </thead>
  <tbody>
    {
      skillSet.map((setSkill) => (
        <tr class="border-b bg-white dark:border-gray-700 dark:bg-gray-800">
          <th
            scope="row"
            class="w-1/4 whitespace-nowrap px-6 py-4 font-medium text-gray-900 dark:text-white"
          >
            {setSkill.name}
          </th>
          <td class="flex justify-start gap-10 px-6 py-4">
            {setSkill.skill.map((skill) => (
              <IconSkill title={skill.title} description={skill.description}>
                <skill.component
                  class="size-10"
                  data-tooltip-target={'tooltip-light-' + skill.title}
                  data-tooltip-style="light"
                />
              </IconSkill>
            ))}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
