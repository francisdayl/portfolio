---
import Certification from '../Certification.astro';
import CloudPractitionerCertification from '@public/assets/icons/cloud_practitioner_badge.webp';
import AIPractitionerCertification from '@public/assets/icons/ai_practitioner_badge.webp';
import DeveloperAssociateCertification from '@public/assets/icons/developer_badge.webp';
import SolutionsArchitectAssociateCertification from '@public/assets/icons/solutions_architect_badge.webp';

interface CertificationProps {
  href: string;
  image: string;
  name: string;
  completed: boolean;
  classnames: string;
}

const certifications: CertificationProps[] = [
  {
    href: 'https://www.credly.com/badges/222987f0-e207-4534-a021-c4370165bac9',
    image: CloudPractitionerCertification.src,
    name: 'AWS Cloud Practitioner',
    completed: true,
    classnames: 'size-44',
  },
  {
    href: 'https://www.credly.com/badges/a85234fb-e9a9-4f6f-bf9b-31bb8cdde36f/',
    image: AIPractitionerCertification.src,
    name: 'AWS AI Practitioner',
    completed: true,
    classnames: 'size-44',
  },
  {
    href: 'https://www.credly.com/badges/09efb229-c626-47d2-8e41-69af911585b5/',
    image: DeveloperAssociateCertification.src,
    name: 'AWS Developer Associate',
    completed: true,
    classnames: 'size-44',
  },
  {
    href: '#courses',
    image: SolutionsArchitectAssociateCertification.src,
    name: 'AWS Developer Associate',
    completed: false,
    classnames: 'grayscale brightness-150 grayscale brightness-150 size-44',
  },
];

const textContext = Astro.props.textContext;
---

<h2 class="mt-8 text-3xl font-semibold">{textContext.Title}</h2>
<ul class="mt-10 flex flex-row justify-center">
  {
    certifications.map((certification) => (
      <Certification
        name={certification.name}
        href={certification.href}
        image={certification.image}
        completed={certification.completed}
        classnames={certification.classnames}
        textContext={textContext}
      />
    ))
  }
</ul>
